# Umgebungsvariablen für yaml_config_support CLI
#
# Optional: Falls nicht gesetzt, werden System-Defaults verwendet.
# Kopieren zu: .env (wird von scripts/cli_yaml_config_fill.py gelesen)
#

# Python-Executable (falls nicht 'python3' im PATH)
# Nutze z.B.: PYTHON_BIN=python3.11
PYTHON_BIN=python3

# Temp-Verzeichnis für Tests behalten (zur Diagnose)
# Setze auf 1, um Test-Artefakte in /tmp/ zu bewahren
# KEEP_TEST_TEMPDIRS=1

# Verbose-Modus (wird auch via CLI --verbose gesetzt)
# VERBOSE=1

